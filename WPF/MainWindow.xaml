<Window x:Class="MultiPointAutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiPoint AutoClicker" Width="1120" Height="1000"
        MinWidth="900" MinHeight="900" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="#242424"
                BorderThickness="1" CornerRadius="7" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MULTIPOINT" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="AUTOCLICKER" FontSize="10" Foreground="#777777" Margin="0,3,0,30"/>
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="#777777" Margin="0,0,0,12"/>
                    <Button x:Name="PointsNavButton" Content="◉   Точки клика" Click="ShowPoints_Click"
                            HorizontalContentAlignment="Left" Padding="10" FontSize="12" Margin="0,0,0,7"/>
                    <Button x:Name="DetectionNavButton" Content="◎   Сработка" Click="ShowDetection_Click"
                            HorizontalContentAlignment="Left" Padding="10" FontSize="12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#292929" Margin="0,0,0,14"/>
                    <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" FontSize="9" Foreground="#777777" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Добавить точку" FontSize="11" Foreground="#B8B8B8"/>
                        <TextBlock Grid.Column="1" Text="F6" FontSize="11" Foreground="White"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Запуск" FontSize="11" Foreground="#B8B8B8"/>
                        <TextBlock Grid.Column="1" Text="F8" FontSize="11" Foreground="White"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Остановка" FontSize="11" Foreground="#B8B8B8"/>
                        <TextBlock Grid.Column="1" Text="F9" FontSize="11" Foreground="White"/>
                    </Grid>
                    <TextBlock Text="v2.1  /  WPF + OCR" FontSize="9" Foreground="#555555" Margin="0,24,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid x:Name="MainContentPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,2,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Точки клика" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Настрой координаты и индивидуальное время для каждой точки."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#111111" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="4" Padding="11,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#777777" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusLabel" Text="ОСТАНОВЛЕН" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#BBBBBB"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="СПИСОК ТОЧЕК" FontSize="9" Foreground="#777777" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PointCount" Text="  /  0" FontSize="9" Foreground="#BBBBBB" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+  Добавить точку  [F6]" Click="AddPoint_Click" Padding="14,8" FontSize="11"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
                <DataGrid x:Name="PointsGrid" ItemsSource="{Binding Points}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#292929"
                          Background="#101010" Foreground="#EEEEEE" BorderThickness="0"
                          RowBackground="#101010" AlternatingRowBackground="#131313"
                          SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False"
                          BeginningEdit="PointsGrid_BeginningEdit">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#929292"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#303030"/>
                            <Setter Property="Padding" Value="12,13"/><Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,12"/>
                            <Setter Property="Foreground" Value="#EAEAEA"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#242424"/>
                            <Setter Property="Foreground" Value="#EEEEEE"/>
                            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#252525"/></Trigger></Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="КООРДИНАТА X" Binding="{Binding X, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="КООРДИНАТА Y" Binding="{Binding Y, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="ИНТЕРВАЛ, СЕК." Binding="{Binding IntervalSeconds, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="УДЕРЖАНИЕ, СЕК." Binding="{Binding HoldSeconds, UpdateSourceTrigger=LostFocus}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Обновить координаты" Click="UpdatePoint_Click" Margin="0,0,8,0" FontSize="11" Padding="13,9"/>
                <Button Content="Удалить точку" Click="DeletePoint_Click" FontSize="11" Padding="13,9"/>
                <TextBlock Text="Изменения параметров применяются после остановки." Foreground="#777777"
                           FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="4" Margin="0,18,0,0" Background="#101010" BorderBrush="#292929"
                    BorderThickness="1" CornerRadius="5" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="РАСПОЗНАВАНИЕ ЭКРАНА · OCR" FontSize="9" Foreground="#929292"/>
                        <TextBlock x:Name="OcrStatusText" Text="Отключено · поиск слова «Ответить» на экране игры"
                                   FontSize="11" Foreground="#D0D0D0" Margin="0,6,12,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OcrStartButton" Content="ВКЛЮЧИТЬ OCR" Click="OcrStart_Click"
                                Padding="15,10" FontSize="10"/>
                        <Button x:Name="OcrStopButton" Content="ОТКЛЮЧИТЬ" Click="OcrStop_Click"
                                Padding="15,10" FontSize="10" Margin="7,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="0,16,0,0" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="5" Padding="14">
                <StackPanel>
                    <TextBlock Text="TELEGRAM · УВЕДОМЛЕНИЯ И УПРАВЛЕНИЕ" FontSize="9" Foreground="#929292"/>
                    <TextBlock x:Name="TelegramStatusText" Text="Не подключён · уведомления после настройки" FontSize="10" Foreground="#BDBDBD" Margin="0,5,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="ТОКЕН БОТА" FontSize="9" Foreground="#777777" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TelegramTokenBox" Height="32" Padding="8,6" Background="#171717" Foreground="White" BorderBrush="#383838" BorderThickness="1" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CHAT ID" FontSize="9" Foreground="#777777" Margin="0,0,0,5"/>
                            <TextBox x:Name="TelegramChatIdBox" Height="32" Padding="8,6" Background="#171717" Foreground="White" BorderBrush="#383838" BorderThickness="1" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="ПОЛУЧИТЬ CHAT ID" Click="TelegramGetChatId_Click" Padding="12,8" FontSize="9" Margin="0,0,7,0"/>
                        <Button Content="СОХРАНИТЬ" Click="TelegramSave_Click" Padding="12,8" FontSize="9" Margin="0,0,7,0"/>
                        <Button Content="ТЕСТ + ПУЛЬТ" Click="TelegramTest_Click" Padding="12,8" FontSize="9"/>
                    </StackPanel>
                    <Border Height="1" Background="#292929" Margin="0,12,0,10"/>
                    <TextBlock Text="КАРТИНКА ДЛЯ УВЕДОМЛЕНИЙ OCR" FontSize="9" Foreground="#929292" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="74" Height="54" Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Image x:Name="AlertImagePreview" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="AlertImageName" Grid.Column="1" Text="Картинка не выбрана" FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Grid.Column="2" Content="ВЫБРАТЬ КАРТИНКУ" Click="ChooseAlertImage_Click" Padding="12,9" FontSize="9"/>
                    </Grid>
                    <TextBlock Text="В Telegram доступны команды запуска и остановки. После обнаружения слова «Ответить» выбери вариант ответа кнопкой в Telegram." FontSize="9" Foreground="#777777" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="УПРАВЛЕНИЕ" FontSize="9" Foreground="#777777"/>
                    <TextBlock x:Name="StatusText" Text="Добавь точку, чтобы начать работу."
                               FontSize="11" Foreground="#B0B0B0" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="▶   ЗАПУСТИТЬ  [F8]" Click="Start_Click"
                            Background="#F0F0F0" Foreground="#090909" BorderBrush="#F0F0F0"
                            FontWeight="SemiBold" Padding="22,13" Margin="0,0,8,0"/>
                    <Button x:Name="StopButton" Content="■   СТОП  [F9]" Click="Stop_Click" Padding="22,13" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
            </Grid>
            <Grid x:Name="DetectionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,2,0,18">
                    <TextBlock Text="Сработка" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Мониторинг игрового экрана и обнаружений OCR по слову «Ответить»."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ИЗОБРАЖЕНИЕ ИГРЫ" FontSize="9" Foreground="#929292" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PreviewLiveLabel" Grid.Column="1" Text="● LIVE · ожидание" FontSize="9" Foreground="#888888"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#080808" BorderBrush="#292929" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Image x:Name="GamePreviewImage" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,14,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="5" Padding="14">
                        <StackPanel>
                            <TextBlock Text="ВСЕГО ОБНАРУЖЕНИЙ" FontSize="9" Foreground="#929292"/>
                            <TextBlock x:Name="DetectionCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="5" Padding="14">
                        <StackPanel>
                            <TextBlock Text="СТАТУС OCR" FontSize="9" Foreground="#929292"/>
                            <TextBlock x:Name="DetectionOcrStatusText" Text="Отключено" FontSize="13" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="3" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="5" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ЖУРНАЛ СРАБАТЫВАНИЙ" FontSize="9" Foreground="#929292" Margin="0,0,0,8"/>
                        <ListBox x:Name="DetectionLogList" Background="Transparent" BorderThickness="0"
                                 Foreground="#D0D0D0" FontSize="10" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>